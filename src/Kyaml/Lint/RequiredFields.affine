// Kyaml.Lint.RequiredFields - Lint rule for required K8s fields
//
// Checks that all required fields for a Kubernetes resource are present.

module Kyaml.Lint.RequiredFields

import Kyaml.Ast

// ============================================================================
// Required Fields Definition
// ============================================================================

/**
 * Defines required fields for different K8s resource kinds.
 * Each kind has a set of fields that must be present.
 */
type RequiredFields = Map<string, list<string>>

/**
 * Get required fields for a specific kind.
 */
getRequiredFields :: string -> list<string>
getRequiredFields kind = 
  match requiredFieldsMap.lookup kind with
    | Some fields -> fields
    | None -> defaultRequiredFields

where
  // Map of kind -> required field paths (JSON path format)
  requiredFieldsMap :: Map<string, list<string>>
  requiredFieldsMap = emptyMap
    .insert "Deployment" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec",
      "spec.selector",
      "spec.template",
      "spec.template.metadata",
      "spec.template.spec"
    ]
    .insert "StatefulSet" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec",
      "spec.selector",
      "spec.template",
      "spec.template.metadata",
      "spec.template.spec",
      "spec.serviceName"
    ]
    .insert "DaemonSet" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec",
      "spec.selector",
      "spec.template",
      "spec.template.metadata",
      "spec.template.spec"
    ]
    .insert "Service" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec"
    ]
    .insert "ConfigMap" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name"
    ]
    .insert "Secret" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name"
    ]
    .insert "Namespace" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name"
    ]
    .insert "Ingress" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec"
    ]
    .insert "PersistentVolume" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec"
    ]
    .insert "PersistentVolumeClaim" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec"
    ]
    .insert "Job" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec",
      "spec.template",
      "spec.template.spec"
    ]
    .insert "CronJob" [
      "apiVersion",
      "kind",
      "metadata",
      "metadata.name",
      "spec",
      "spec.schedule",
      "spec.jobTemplate"
    ]

  defaultRequiredFields = [
    "apiVersion",
    "kind",
    "metadata",
    "metadata.name"
  ]

// ============================================================================
// Lint Rule Implementation
// ============================================================================

/**
 * Represents a lint issue found in a KYAML document.
 */
type LintIssue = {
  ruleId: string,
  severity: Severity,
  message: string,
  path: list<string>,
  location: Option<SourceLocation>
}

/**
 * Severity levels for lint issues.
 */
type Severity
  = Error
  | Warning
  | Info

/**
 * The lint rule function type.
 */
type LintRule = KYamlDoc -> list<LintIssue>

/**
 * Check for missing required fields in a KYAML document.
 */
checkRequiredFields :: LintRule
checkRequiredFields doc = 
  case doc of
    KResource resource ->
      let kind = resource.kind
      let required = getRequiredFields kind
      let missing = filter (\field -> not (hasField resource field)) required
      map (\field -> {
        ruleId: "required-fields",
        severity: Error,
        message: "Missing required field: " ++ field,
        path: [field],
        location: None
      }) missing
    KGeneric _ ->
      []  // Generic YAML doesn't have required fields

where
  /**
   * Check if a resource has a specific field (using JSON path notation).
   */
  hasField :: Resource -> string -> bool
  hasField resource path = 
    let parts = splitPath path
    hasFieldAtParts resource parts
  
  splitPath path = split path "."
  
  hasFieldAtParts resource parts = 
    let rec loop obj remaining = 
      case remaining of
        [] -> true
        (part :: rest) ->
          case obj of
            | None -> false
            | Some (NScalar _) -> false  // Can't go deeper into scalar
            | Some (NSequence _) -> false  // Path doesn't work on arrays without index
            | Some (NMapping m) ->
                loop (m.lookup part) rest
            | Some (NAnchor (_, node)) -> loop (Some node) rest
            | Some (NAlias _) -> false  // Simplified
            | Some (NTag (_, node)) -> loop (Some node) rest
    in
      loop (Some (resourceToNode resource)) parts
  
  resourceToNode resource = NMapping (emptyMap
    .insert "apiVersion" (NScalar (SString resource.apiVersion))
    .insert "kind" (NScalar (SString resource.kind))
    .insert "metadata" (metadataToNode resource.metadata)
    .insert "spec" resource.spec
    .insertIfSome "status" resource.status
  )
  
  metadataToNode metadata = NMapping (emptyMap
    .insert "name" (NScalar (SString metadata.name))
    .insertIfSome "namespace" (metadata.namespace |> map (\ns -> NScalar (SString ns)))
    .insert "labels" (mapToNode metadata.labels)
    .insert "annotations" (mapToNode metadata.annotations)
    .insertIfSome "uid" (metadata.uid |> map (\uid -> NScalar (SString uid)))
    .insertIfSome "resourceVersion" (metadata.resourceVersion |> map (\rv -> NScalar (SString rv)))
    .insertIfSome "creationTimestamp" (metadata.creationTimestamp |> map (\ts -> NScalar (SString ts)))
    .insertIfSome "generation" (metadata.generation |> map (\gen -> NScalar (SInt gen)))
  )
  
  mapToNode m = NMapping (foldl (\acc, k, v -> acc.insert k (NScalar (SString v))) emptyMap m)
  
  insertIfSome m key optVal = 
    case optVal of
      Some val -> m.insert key val
      None -> m

// ============================================================================
// Rule Registration
// ============================================================================

/**
 * Get the rule ID for this linter.
 */
ruleId :: string
ruleId = "required-fields"

/**
 * Get the rule description.
 */
description :: string
description = "Checks that all required Kubernetes fields are present."

/**
 * Get the default severity.
 */
defaultSeverity :: Severity
defaultSeverity = Error

/**
 * The rule itself.
 */
rule :: LintRule
rule = checkRequiredFields
