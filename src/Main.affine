// kcq Main Module
// Entry point for the Kubernetes Configuration Query tool

module Main

import Kyaml

// Main entry point
effect IO {
  fn print(s: String) -> ();
  fn println(s: String) -> ();
}

fn main() -{IO}-> () {
    println("kcq v0.1.0 — Kubernetes Configuration Query");
    println("AffineScript KYAML Processor");
    println("License: MPL-2.0 (code) / CC-BY-SA-4.0 (docs)");
    println("");
    println("Usage: kcq <command> [options]");
    println("");
    println("Commands (none implemented yet; see docs/status/ROADMAP.adoc):");
    println("  parse     - Parse YAML/JSON input");
    println("  lint      - Lint Kubernetes YAML");
    println("  get      - Get value from YAML path");
    println("  set      - Set value at YAML path");
    println("  del      - Delete value at YAML path");
    println("  fmt      - Format/pretty-print YAML");
    println("  query    - Query YAML with path expression");
    println("");
    println("Examples:");
    println("  echo 'apiVersion: v1\\nkind: Pod' | kcq parse");
    println("  echo 'apiVersion: v1\\nkind: Pod\\nmetadata:\\n  name: test' | kcq lint");
    println("  echo 'apiVersion: v1\\nkind: Pod\\nmetadata:\\n  name: test' | kcq get metadata.name");
}
