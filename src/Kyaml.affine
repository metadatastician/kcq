// KYAML — Main module for Kubernetes YAML processing
// High-level API for parsing, linting, and querying Kubernetes manifests

module Kyaml

import Kyaml.Ast
import Kyaml.Lexer
import Kyaml.Parser
import Kyaml.Lint.RequiredFields

// Main KYAML processing functions

/// Parse YAML string and return AST document
pub fn parse_yaml(input: &str) -> Ast::ParseResult {
    Parser::parse_yaml(input)
}

/// Parse YAML string and return Kubernetes resources
pub fn parse_k8s(input: &str) -> [Ast::K8sResource] {
    Parser::parse_k8s_resources(input)
}

/// Validate YAML syntax without full parsing
pub fn validate_yaml_syntax(input: &str) -> Bool {
    let mut lexer = Lexer::new(input);
    let tokens = Lexer::tokenize(&mut lexer);
    
    // Check for error tokens
    for token in tokens {
        match token.token {
            Token::Error(_) => return false,
            _ => continue,
        }
    }
    
    true
}

/// Lint Kubernetes YAML with all available rules
pub fn lint_k8s(yaml: &str) -> [Ast::LintIssue] {
    let mut issues = [];
    
    // Parse the YAML first
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(doc) => {
            // Apply required fields lint rule
            let required_fields_issues = RequiredFields::lint_required_fields(&doc);
            issues = issues ++ required_fields_issues;
        },
        Ast::ParseResult::Error(err) => {
            issues = issues ++ [{
                rule: "syntax-error",
                message: "YAML syntax error: " ++ err.message,
                severity: Ast::LintSeverity::Error,
                location: {
                    line: err.line,
                    column: err.column,
                    path: None,
                },
            }];
        }
    }
    
    issues
}

/// Query YAML with a path expression (simplified jmespath-like)
pub fn query_yaml(yaml: &str, path: &str) -> Option<Ast::YamlValue> {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(doc) => {
            query_value(&doc.root, path)
        },
        Ast::ParseResult::Error(_) => None,
    }
}

/// Query a parsed value with a path expression
fn query_value(value: &Ast::YamlValue, path: &str) -> Option<Ast::YamlValue> {
    // Split path by dots
    let parts = split_path(path);
    
    if len(parts) == 0 {
        return Some(value.clone());
    }
    
    let mut current = value;
    
    for part in parts {
        current = match current {
            Ast::YamlValue::Mapping(map) => {
                if map.contains(part) {
                    map.get(part)
                } else {
                    None
                }
            },
            Ast::YamlValue::Sequence(seq) => {
                // Try to parse part as index
                match parse_int(part) {
                    Some(index) => {
                        if index >= 0 && index < len(seq) {
                            Some(seq[index])
                        } else {
                            None
                        }
                    },
                    None => None,
                }
            },
            _ => None,
        };
        
        // If we hit None, the path doesn't exist
        if current == None {
            return None;
        }
    }
    
    current
}

// Split a path string by dots
fn split_path(path: &str) -> [String] {
    let mut parts = [];
    let mut current = "";
    
    for ch in path {
        if ch == '.' {
            parts = parts ++ [current];
            current = "";
        } else {
            current = current ++ string_from_char(ch);
        }
    }
    
    if current != "" {
        parts = parts ++ [current];
    }
    
    parts
}

// Parse a string as integer
fn parse_int(s: String) -> Option<Int> {
    let mut result = 0;
    let mut sign = 1;
    let mut i = 0;
    
    if len(s) > 0 && string_get(s, 0) == '-' {
        sign = -1;
        i = 1;
    }
    
    while i < len(s) {
        let ch = string_get(s, i);
        if ch >= '0' && ch <= '9' {
            result = result * 10 + (char_to_int(ch) - char_to_int('0'));
        } else {
            return None;
        }
        i = i + 1;
    }
    
    Some(result * sign)
}

/// Get a value from YAML with a simple path
pub fn get_yaml(yaml: &str, path: &str) -> Option<Ast::YamlValue> {
    query_yaml(yaml, path)
}

/// Set a value in YAML (returns modified YAML string)
pub fn set_yaml(yaml: &str, path: &str, value: Ast::YamlValue) -> Option<String> {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(mut doc) => {
            if set_value(&mut doc.root, path, value) {
                // Convert back to YAML string
                Some(format_yaml(&doc.root))
            } else {
                None
            }
        },
        Ast::ParseResult::Error(_) => None,
    }
}

/// Set a value in a YAML structure
fn set_value(root: &mut Ast::YamlValue, path: &str, value: Ast::YamlValue) -> Bool {
    let parts = split_path(path);
    
    if len(parts) == 0 {
        *root = value;
        return true;
    }
    
    let mut current = root;
    
    // Navigate to the parent of the target
    for i in range(0, len(parts) - 1) {
        let part = parts[i];
        current = match current {
            Ast::YamlValue::Mapping(map) => {
                if !map.contains(part) {
                    // Create an empty mapping for missing path segments
                    map{part} = Ast::YamlValue::Mapping({});
                }
                map.get_mut(part)
            },
            Ast::YamlValue::Sequence(seq) => {
                match parse_int(part) {
                    Some(index) => {
                        if index >= len(seq) {
                            // Extend the sequence if needed
                            while len(seq) <= index {
                                seq = seq ++ [Ast::YamlValue::Null];
                            }
                        }
                        Some(&mut seq[index])
                    },
                    None => return false,
                }
            },
            _ => return false,
        };
        
        if current == None {
            return false;
        }
    }
    
    // Set the final value
    let last_part = parts[len(parts) - 1];
    
    match current {
        Some(Ast::YamlValue::Mapping(map)) => {
            map{last_part} = value;
            true
        },
        Some(Ast::YamlValue::Sequence(seq)) => {
            match parse_int(last_part) {
                Some(index) => {
                    if index < len(seq) {
                        seq[index] = value;
                        true
                    } else {
                        false
                    }
                },
                None => false,
            }
        },
        _ => false,
    }
}

/// Delete a value from YAML
pub fn del_yaml(yaml: &str, path: &str) -> Option<String> {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(mut doc) => {
            if delete_value(&mut doc.root, path) {
                Some(format_yaml(&doc.root))
            } else {
                None
            }
        },
        Ast::ParseResult::Error(_) => None,
    }
}

/// Delete a value from a YAML structure
fn delete_value(root: &mut Ast::YamlValue, path: &str) -> Bool {
    let parts = split_path(path);
    
    if len(parts) == 0 {
        return false;
    }
    
    if len(parts) == 1 {
        // Special case: delete from root - not really possible
        *root = Ast::YamlValue::Null;
        return true;
    }
    
    let mut parent = root;
    
    // Navigate to the parent
    for i in range(0, len(parts) - 1) {
        let part = parts[i];
        parent = match parent {
            Ast::YamlValue::Mapping(map) => {
                if !map.contains(part) {
                    return false;
                }
                Some(map.get_mut(part))
            },
            Ast::YamlValue::Sequence(seq) => {
                match parse_int(part) {
                    Some(index) => {
                        if index < len(seq) {
                            Some(&mut seq[index])
                        } else {
                            return false;
                        }
                    },
                    None => return false,
                }
            },
            _ => return false,
        };
        
        if parent == None {
            return false;
        }
    }
    
    // Delete the final value
    let last_part = parts[len(parts) - 1];
    
    match parent {
        Some(Ast::YamlValue::Mapping(map)) => {
            // Create a new map without the key
            let mut new_map = {};
            for key in map.keys() {
                if key != last_part {
                    new_map{key} = map{key};
                }
            }
            *map = new_map;
            true
        },
        Some(Ast::YamlValue::Sequence(seq)) => {
            match parse_int(last_part) {
                Some(index) => {
                    if index < len(seq) {
                        // Remove element at index
                        let mut new_seq = [];
                        for i in range(0, len(seq)) {
                            if i != index {
                                new_seq = new_seq ++ [seq[i]];
                            }
                        }
                        *seq = new_seq;
                        true
                    } else {
                        false
                    }
                },
                None => false,
            }
        },
        _ => false,
    }
}

/// Format YAML value back to string
fn format_yaml(value: &Ast::YamlValue) -> String {
    format_yaml_internal(value, 0)
}

fn format_yaml_internal(value: &Ast::YamlValue, indent: Int) -> String {
    let indent_str = string_repeat(" ", indent);
    
    match value {
        Ast::YamlValue::Null => "null",
        Ast::YamlValue::Bool(b) => if b { "true" } else { "false" },
        Ast::YamlValue::Int(i) => int_to_string(i),
        Ast::YamlValue::Float(f) => float_to_string(f),
        Ast::YamlValue::String(s) => {
            // Check if string needs quoting
            if s == "" || contains_whitespace(s) || s == "true" || s == "false" || s == "null" || s == "" {
                "\"" ++ escape_string(s) ++ "\""
            } else {
                s
            }
        },
        Ast::YamlValue::Sequence(seq) => {
            if len(seq) == 0 {
                "[]"
            } else {
                let mut result = "\n";
                for item in seq {
                    result = result ++ indent_str ++ "- " ++ format_yaml_internal(item, 0) ++ "\n";
                }
                result
            }
        },
        Ast::YamlValue::Mapping(map) => {
            if len(map.keys()) == 0 {
                "{}"
            } else {
                let mut result = "";
                for key in map.keys() {
                    let val = map{key};
                    let formatted_val = format_yaml_internal(val, indent + 2);
                    if starts_with(formatted_val, "\n") {
                        result = result ++ indent_str ++ key ++ ":" ++ formatted_val ++ "\n";
                    } else {
                        result = result ++ indent_str ++ key ++ ": " ++ formatted_val ++ "\n";
                    }
                }
                result
            }
        },
        Ast::YamlValue::Anchor(s) => "&" ++ s,
        Ast::YamlValue::Alias(s) => "*" ++ s,
        Ast::YamlValue::Tag(handle, suffix) => "!<" ++ handle ++ ">" ++ suffix,
    }
}

// Check if string contains whitespace
fn contains_whitespace(s: String) -> Bool {
    for ch in s {
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
            return true;
        }
    }
    false
}

// Escape string for quoting
fn escape_string(s: String) -> String {
    let mut result = "";
    for ch in s {
        match ch {
            '\\' => result = result ++ "\\\\",
            '"' => result = result ++ "\\\"",
            '\n' => result = result ++ "\\n",
            '\t' => result = result ++ "\\t",
            _ => result = result ++ string_from_char(ch),
        }
    }
    result
}

// Repeat string
fn string_repeat(s: String, n: Int) -> String {
    let mut result = "";
    for _ in range(0, n) {
        result = result ++ s;
    }
    result
}

// Check if string starts with prefix
fn starts_with(s: String, prefix: String) -> Bool {
    if len(prefix) > len(s) {
        false
    } else {
        string_sub(s, 0, len(prefix)) == prefix
    }
}

// Convert char to string
fn string_from_char(c: Char) -> String {
    int_to_string(char_to_int(c))
}

/// Pretty print YAML with consistent formatting
pub fn pretty_print_yaml(yaml: &str) -> Option<String> {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(doc) => Some(format_yaml(&doc.root)),
        Ast::ParseResult::Error(_) => None,
    }
}

/// Check if YAML contains Kubernetes resources
pub fn is_k8s_yaml(yaml: &str) -> Bool {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(doc) => {
            !is_empty_resources(doc.resources) || is_k8s_resource(&doc.root)
        },
        Ast::ParseResult::Error(_) => false,
    }
}

// Check if resources array is empty
fn is_empty_resources(resources: [Ast::K8sResource]) -> Bool {
    len(resources) == 0
}

/// Extract all Kubernetes resources from YAML
pub fn extract_k8s_resources(yaml: &str) -> [Ast::K8sResource] {
    match parse_yaml(yaml) {
        Ast::ParseResult::Success(doc) => doc.resources,
        Ast::ParseResult::Error(_) => [],
    }
}
