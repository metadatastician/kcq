// Kyaml - Main module for Kubernetes YAML processing
//
// This is the main entry point for the kcq library.
// It provides a high-level API for parsing, linting, and querying KYAML.

module Kyaml

import Kyaml.Ast
import Kyaml.Lexer
import Kyaml.Parser
import Kyaml.Lint.RequiredFields

// ============================================================================
// Public API Types
// ============================================================================

/**
 * Represents the result of parsing KYAML.
 */
type ParseResult
  = ParseSuccess of KYamlFile
  | ParseFailure of list<ParseError>

/**
 * Represents the result of linting.
 */
type LintResult = {
  file: string,
  docs: list<LintedDoc>
}

/**
 * Represents a linted document.
 */
type LintedDoc = {
  doc: KYamlDoc,
  issues: list<LintIssue>
}

/**
 * Combined lint issue type (from all rules).
 */
type LintIssue = {
  ruleId: string,
  severity: Severity,
  message: string,
  path: list<string>,
  location: Option<SourceLocation>
}

/**
 * Severity levels for lint issues.
 */
type Severity
  = Error
  | Warning
  | Info

// ============================================================================
// Public API Functions
// ============================================================================

/**
 * Parse KYAML from a string.
 * Returns ParseResult containing either the parsed KYamlFile or parse errors.
 */
parse :: string -> ParseResult
parse input = 
  case parseKyaml input of
    Ok file -> ParseSuccess file
    Err e -> ParseFailure [e]

/**
 * Parse KYAML from a file.
 * Reads the file and parses its contents.
 */
parseFile :: string -> IO<ParseResult>
parseFile path = do
  content <- readFile path
  pure (parse content)

/**
 * Lint a KYAML document.
 * Applies all registered lint rules.
 */
lint :: KYamlDoc -> list<LintIssue>
lint doc = 
  let rules = [
    Kyaml.Lint.RequiredFields.rule
    // Add more rules here
  ]
  let allIssues = []
  let rec loop remainingRules issues = 
    case remainingRules of
      [] -> issues
      (rule :: rest) ->
        let ruleIssues = rule doc
        loop rest (issues ++ ruleIssues)
  in
    loop rules allIssues

/**
 * Lint a KYAML file (multi-document).
 */
lintFile :: string -> list<LintIssue>
lintFile input = 
  case parse input of
    ParseSuccess file ->
      let docIssues = map (\doc -> lint doc) file
      concat docIssues
    ParseFailure _ ->
      []  // Can't lint if parse fails

/**
 * Query a KYAML document with a path expression.
 * Simple path query support (e.g., ".spec.replicas").
 */
query :: KYamlDoc -> string -> Option<Node>
query doc path = 
  case doc of
    KResource resource ->
      queryResource resource path
    KGeneric node ->
      queryNode node (splitPath path)

where
  splitPath path = 
    if path == "" || path == "." then []
    else if path[0] == '.' then
      split (substring path 1 (length path)) "."
    else
      split path "."
  
  queryResource resource path = 
    let node = resourceToNode resource
    queryNode node (splitPath path)
  
  resourceToNode resource = NMapping (emptyMap
    .insert "apiVersion" (NScalar (SString resource.apiVersion))
    .insert "kind" (NScalar (SString resource.kind))
    .insert "metadata" (metadataToNode resource.metadata)
    .insert "spec" resource.spec
    .insertIfSome "status" resource.status
  )
  
  metadataToNode metadata = NMapping (emptyMap
    .insert "name" (NScalar (SString metadata.name))
    .insertIfSome "namespace" (metadata.namespace |> map (\ns -> NScalar (SString ns)))
    .insert "labels" (mapToNode metadata.labels)
    .insert "annotations" (mapToNode metadata.annotations)
  )
  
  mapToNode m = NMapping (foldl (\acc, k, v -> acc.insert k (NScalar (SString v))) emptyMap m)
  
  insertIfSome m key optVal = 
    case optVal of
      Some val -> m.insert key val
      None -> m
  
  queryNode node pathParts = 
    let rec loop current remaining = 
      case remaining of
        [] -> Some current
        (part :: rest) ->
          case current of
            NScalar _ -> None  // Can't go deeper
            NSequence list ->
              // Try to parse part as index
              if isInteger part then
                let idx = parseInt part
                if idx >= 0 && idx < length list then
                  loop list[idx] rest
                else
                  None
              else if part == "[]" then
                // Apply to all elements
                let results = map (\item -> loop item rest) list
                if all isSome results then
                  Some (NSequence (map fromSome results))
                else
                  None
              else
                None
            NMapping m ->
              loop (m.lookup part |> default NScalar SNull) rest
            _ -> None  // For now, simplified
    in
      loop node pathParts
  
  fromSome opt = case opt of | Some v -> v | None -> NScalar SNull
  
  isInteger s = 
    if s == "" then false
    else all (\c -> c >= '0' && c <= '9') s[0..length(s)-1] || 
         (s[0] == '-' && all (\c -> c >= '0' && c <= '9') s[1..length(s)-1])
  
  parseInt s = 
    if s == "" then 0
    else if s[0] == '-' then -parseInt s[1..length(s)-1]
    else foldl (\acc, c -> acc * 10 + (ord c - ord '0')) 0 s

// ============================================================================
// Set/Update Operations
// ============================================================================

/**
 * Set a value at a path in a KYAML document.
 * Returns a new document with the value set.
 */
set :: KYamlDoc -> string -> Node -> KYamlDoc
set doc path value = 
  case doc of
    KResource resource ->
      KResource (setResource resource path value)
    KGeneric node ->
      KGeneric (setNode node (splitPath path) value)

where
  setResource resource path value = 
    let newSpec = setNode resource.spec (splitPathWithoutRoot path) value
    { resource | spec = newSpec }
  
  splitPathWithoutRoot path = 
    let parts = splitPath path
    case parts of
      [] -> []
      (_ :: rest) -> rest
  
  setNode node pathParts value = 
    let rec loop current remaining = 
      case remaining of
        [] -> value
        [part] ->
          case current of
            NMapping m ->
              NMapping (m.insert part value)
            NSequence list ->
              if isInteger part then
                let idx = parseInt part
                if idx >= 0 && idx < length list then
                  NSequence (setIndex list idx value)
                else
                  current  // Can't set, return original
              else if part == "[]" then
                // Append to all elements? Or replace all?
                current
              else
                current
            _ -> current
        (part :: rest) ->
          case current of
            NMapping m ->
              let newValue = loop (m.lookupDefault (NScalar SNull) part) rest
              NMapping (m.insert part newValue)
            NSequence list ->
              if isInteger part then
                let idx = parseInt part
                if idx >= 0 && idx < length list then
                  let newItem = loop list[idx] rest
                  NSequence (setIndex list idx newItem)
                else
                  current
              else if part == "[]" then
                // Apply to all elements
                NSequence (map (\item -> loop item rest) list)
              else
                current
            _ -> current
    in
      loop node pathParts
  
  setIndex list idx value = 
    let rec loop acc remaining = 
      case remaining of
        [] -> reverse acc
        (i, x) :: rest ->
          if i == idx then
            loop (value :: acc) rest
          else
            loop (x :: acc) rest
    in
      let indexed = zip [0..length(list)-1] list
      loop [] indexed

// ============================================================================
// Delete Operations
// ============================================================================

/**
 * Delete a field at a path in a KYAML document.
 * Returns a new document with the field removed.
 */
delete :: KYamlDoc -> string -> KYamlDoc
delete doc path = 
  case doc of
    KResource resource ->
      KResource (deleteResource resource path)
    KGeneric node ->
      KGeneric (deleteNode node (splitPath path))

where
  deleteResource resource path = 
    let newSpec = deleteNode resource.spec (splitPathWithoutRoot path) 
    { resource | spec = newSpec }
  
  deleteNode node pathParts = 
    let rec loop current remaining = 
      case remaining of
        [] -> current  // Nothing to delete at this level
        [part] ->
          case current of
            NMapping m ->
              NMapping (m.remove part)
            NSequence list ->
              if isInteger part then
                let idx = parseInt part
                if idx >= 0 && idx < length list then
                  NSequence (removeIndex list idx)
                else
                  current
              else
                current
            _ -> current
        (part :: rest) ->
          case current of
            NMapping m ->
              let newValue = loop (m.lookupDefault (NScalar SNull) part) rest
              // If newValue is SNull, remove the key
              if newValue == NScalar SNull then
                NMapping (m.remove part)
              else
                NMapping (m.insert part newValue)
            NSequence list ->
              if isInteger part then
                let idx = parseInt part
                if idx >= 0 && idx < length list then
                  let newItem = loop list[idx] rest
                  if newItem == NScalar SNull then
                    NSequence (removeIndex list idx)
                  else
                    NSequence (setIndex list idx newItem)
                else
                  current
              else if part == "[]" then
                // Apply to all elements
                NSequence (map (\item -> loop item rest) list)
              else
                current
            _ -> current
    in
      loop node pathParts
  
  removeIndex list idx = 
    let rec loop acc remaining i = 
      case remaining of
        [] -> reverse acc
        (x) :: rest ->
          if i == idx then
            loop acc rest (i + 1)
          else
            loop (x :: acc) rest (i + 1)
    in
      loop [] list 0

// ============================================================================
// Utility Functions
// ============================================================================

/**
 * Convert KYAML to YAML string.
 * Pretty-prints the KYAML structure.
 */
toYaml :: KYamlFile -> string
toYaml file = 
  join "\n---\n" (map docToYaml file)

where
  docToYaml doc = 
    case doc of
      KResource resource -> resourceToYaml resource
      KGeneric node -> nodeToYaml node 0
  
  resourceToYaml resource = 
    let m = emptyMap
      .insert "apiVersion" (NScalar (SString resource.apiVersion))
      .insert "kind" (NScalar (SString resource.kind))
      .insert "metadata" (metadataToNode resource.metadata)
      .insert "spec" resource.spec
    in
      case resource.status of
        Some status -> nodeToYaml (NMapping (m.insert "status" status)) 0
        None -> nodeToYaml (NMapping m) 0
  
  nodeToYaml node indentLevel = 
    let indent = repeat " " indentLevel
    let childIndent = repeat " " (indentLevel + 2)
    case node of
      NScalar scalar -> indent ++ scalarToYaml scalar
      NSequence list ->
        if list == [] then
          indent ++ "[]"
        else
          foldl (\acc, item -> acc ++ childIndent ++ "- " ++ nodeToYaml item (indentLevel + 4) ++ "\n") (indent ++ "\n") list
      NMapping m ->
        if m.isEmpty then
          indent ++ "{}"
        else
          foldl (\acc, k, v -> 
            acc ++ indent ++ k ++ ": " ++ 
            if isScalarOrEmpty v then
              nodeToYaml v (indentLevel + length k + 2)
            else
              "\n" ++ nodeToYaml v (indentLevel + 2)
            ++ "\n") "" m.toList
      _ -> "# Complex node (not implemented)"
  
  scalarToYaml scalar = 
    case scalar of
      SString s -> 
        if needsQuotes s then
          '\"' ++ escapeString s ++ '\"'
        else
          s
      SInt i -> intToString i
      SFloat f -> floatToString f
      SBool b -> if b then "true" else "false"
      SNull -> "null"
      STimestamp ts -> '\"' ++ ts ++ '\"'
  
  needsQuotes s = 
    s == "" || 
    s[0] == '#' || s[0] == '&' || s[0] == '*' || s[0] == '!' || 
    s[0] == '%' || s[0] == '@' || s[0] == '`' ||
    s[0] == '\"' || s[0] == "'" ||
    s[0] == '\n' ||
    contains s ':' || contains s ' ' || contains s '\t' ||
    contains s '\n' || contains s '#' ||
    s == "true" || s == "false" || s == "null" || s == "~"
  
  escapeString s = 
    foldl (\acc, c -> 
      if c == '\"' then acc ++ "\\\""
      else if c == '\n' then acc ++ "\\n"
      else if c == '\t' then acc ++ "\\t"
      else acc ++ stringOfChar c) "" s
  
  isScalarOrEmpty node = 
    case node of
      NScalar _ -> true
      NSequence [] -> true
      NMapping m -> m.isEmpty
      _ -> false
  
  // Simplified - in real implementation, use proper int/float to string
  intToString i = 
    if i == 0 then "0"
    else if i < 0 then "-" ++ intToString (-i)
    else intToStringHelper i ""
  
  intToStringHelper i acc = 
    if i == 0 then 
      if acc == "" then "0" else acc
    else
      intToStringHelper (i / 10) (stringOfChar (charOfDigit (i % 10)) ++ acc)
  
  charOfDigit d = 
    if d == 0 then '0' else if d == 1 then '1' else if d == 2 then '2' 
    else if d == 3 then '3' else if d == 4 then '4' else if d == 5 then '5'
    else if d == 6 then '6' else if d == 7 then '7' else if d == 8 then '8'
    else '9'
  
  floatToString f = "0.0"  // Simplified for now
