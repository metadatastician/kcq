;; STATE Descriptile Deed for kcq
;; Project state checkpoint
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "kcq-STATE"
  (metadata
    :project "kcq"
    :version "0.1.0"
    :last-updated "2026-10-05"
    :status "active"
  )
  (project-context
    :name "kcq"
    :owner "metadatastician"
    :purpose "Kubernetes Configuration Query — an AffineScript-based KYAML processor that provides a smaller, faster, K8s-aware alternative to yq. Designed to replace yq for Kubernetes workloads with compile-time safety guarantees and domain-specific validation."
    :completion-percentage 5
  )
  (position
    :phase "design"
    :maturity "experimental"
  )
  (route-to-mvp
    (milestone :name "Phase 0: Project scaffolding" :completion 100)
    (milestone :name "Phase 1: Core KYAML parser" :completion 5)
    (milestone :name "Phase 1b: Basic lint rules" :completion 0)
    (milestone :name "Phase 1c: Basic query commands" :completion 0)
    (milestone :name "Phase 1d: Pretty-print and format" :completion 0)
    (milestone :name "Phase 2: Full KYAML support" :completion 0)
    (milestone :name "Phase 2b: Advanced lint rules" :completion 0)
    (milestone :name "Phase 2c: K8s schema validation" :completion 0)
    (milestone :name "Phase 3: Full jq query language" :completion 0)
    (milestone :name "Phase 3b: Full YAML 1.2 support" :completion 0)
    (milestone :name "Phase 4: Multi-format support" :completion 0)
    (milestone :name "Phase 5: Performance optimization" :completion 0)
  )
  (blockers-and-issues
    :blockers (
      "AffineScript text processing libraries need to be verified for YAML parsing"
      "WASM compilation toolchain for AffineScript needs to be production-ready"
      "Performance benchmarks against yq need to be established"
    )
  )
  (dependencies
    :language "AffineScript"
    :runtime "WebAssembly"
    :compiler "hyperpolymath/affinescript"
    :k8s-schema-version "v1.30.x"
  )
  (targets
    :primary ("WebAssembly" "native")
    :secondary ("Docker container")
  )
  (quality-gates
