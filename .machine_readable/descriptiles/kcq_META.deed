;;
;; META Descriptile Deed for kcq
;; Project meta-level information - Architecture decisions, design rationale, governance
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "kcq-META"
  (metadata
    :version "0.1.0"
    :last-updated "2026-10-05"
  )
  (project-info
    :type "binary"
    :description "Kubernetes Configuration Query - KYAML processor CLI tool"
    :languages ("AffineScript")
    :license "MPL-2.0"
    :author "Jonathan D.A. Jewell (hyperpolymath)"
  )
  (architecture-decisions)
  (development-practices
    :build-tool "just"
    :ci-platform "github-actions"
    :package-manager "guix"
  )
  (maintenance-axes
    :scoping-first true
    :execution-order "axis-1 > axis-2 > axis-3"
    :axis-1 ("must > intend > like")
    :axis-2 ("corrective > adaptive > perfective")
    :axis-3 ("systems > compliance > effects")
  )
  (design-rationale
    :primary "AffineScript provides compile-time safety guarantees for YAML processing"
    :secondary "K8s-specific parsing allows for domain-optimized processing"
  )
)
