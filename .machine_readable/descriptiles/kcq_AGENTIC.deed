;;
;; AGENTIC Descriptile Deed for kcq
;; Agent and AI assistant configuration
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "kcq-AGENTIC"
  (agentic-config
    :project "kcq"
    :primary-owner "hyperpolymath"
    :estate "metadatastician"
  )
  (assigned-agents
    (agent :id CLAUDE :role "primary implementation" :capabilities ("AffineScript development" "KYAML parser" "Integration") :trust-level "full")
    (agent :id GEMINI :role "compliance and audit" :capabilities ("Estate audits" "Cross-repo sweeps" "Pattern detection") :trust-level "scoped")
    (agent :id VIBE :role "prototyping and UI" :capabilities ("Rapid prototyping" "Agent integration" "Frontend components") :trust-level "scoped")
  )
  (session-config
    :max-concurrent 3
    :session-timeout "4 hours"
    :context-window "200K tokens"
  )
  (capability-declarations
    :supported-languages ("AffineScript")
    :supported-formats ("YAML" "JSON" "K8s manifests")
    :supported-operations ("parse" "lint" "query" "get" "set" "del" "format")
  )
  (ai-assistance
    :enabled true
    :setup-command "just ai-setup"
    :launcher "kcq-launcher.sh"
  )
)
