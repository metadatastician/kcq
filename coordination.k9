K9!
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>
#
# coordination.k9 — AI Coordination Protocol for kcq
# Kubernetes Configuration Query - AffineScript KYAML processor
#
# Repository: metadatastician/kcq
# Owner: hyperpolymath
#
# Written to coordination grammar 1.1.1 (standards
# 2-protocols/k9-coordination/spec/abnf/coordination-k9-grammar_v1.1.abnf).
# Facts the grammar has no field for live in kcq_chora.deed: the docs
# licence (manifest :docs-license), the estate (ecosystem :ecosystem) and
# the RSR tier target (playbook success-metrics). CRG grade: C.
# Build recipes: see the Justfile. build, test, bench and wasm fail with
# "not implemented" until AffineScript can compile the sources
# (docs/status/ROADMAP.adoc).

metadata:
  schema: k9-coordination
  schema_version: 1.1.1
  generated_by: manual
  last_updated: 2026-10-07

project:
  name: "kcq"
  description: "Kubernetes Configuration Query — AffineScript-based KYAML processor. Intended as a smaller, K8s-aware alternative to yq with compile-time safety guarantees."
  license: MPL-2.0
  repo: metadatastician/kcq
  deed_ref: kcq_chora.deed
  languages:
    - AffineScript
  build_system: just

invariants:
  - id: affinescript-only
    rule: "All implementation code MUST be AffineScript"
    reason: "Primary language constraint for the project"
    severity: critical
  - id: mpl-2.0-code
    rule: "All source code MUST use MPL-2.0 license"
    reason: "Estate standard for code licensing"
    severity: critical
  - id: cc-by-sa-4.0-docs
    rule: "All documentation MUST use CC-BY-SA-4.0 license"
    reason: "Estate standard for documentation licensing"
    severity: critical
  - id: deed-format-compliance
    rule: "Machine-readable descriptive metadata MUST be clauses of kcq_chora.deed; never create a .a2ml file"
    reason: "One deed per repo (owner rulings D308, D312)"
    severity: high
  - id: uuid-v8-compliance
    rule: "Every new identifier MUST be UUIDv8 (standards ADR-008); deed literals use #u5 until the deed ABNF admits v8"
    reason: "Owner ruling D305; #u7 literals are illegal"
    severity: critical
  - id: no-makefiles
    rule: "No Makefiles - use Justfiles instead"
    reason: "Estate standard - make is deprecated"
    severity: critical
  - id: rsr-tier-2-compliant
    rule: "Repository MUST maintain RSR Tier 2 compliance"
    reason: "Project quality standard"
    severity: high
  - id: k9-presence
    rule: "Repository MUST have coordination.k9 file"
    reason: "AI coordination protocol requirement"
    severity: critical
  - id: deed-file-presence
    rule: "Repository MUST have _chora.deed file"
    reason: "One-deed-per-repo doctrine (standards#837)"
    severity: critical
  - id: no-fabricated-artefacts
    rule: "Build, test and release recipes MUST fail rather than emit placeholder binaries or report unrun tests as passed"
    reason: "A placeholder kcq.wasm and a fake test pass were removed; capability honesty"
    severity: critical

protected:
  - path: src/
    reason: "Primary source code"
  - path: coordination.k9
    reason: "AI coordination protocol"
  - path: kcq_chora.deed
    reason: "Repository deed - single source of truth"
  - path: Justfile
    reason: "Build system configuration"
  - path: kcq-launcher.sh
    reason: "Project launcher script"
